# Copy to .env.local (never commit). Staging and prod use different projects and keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Feature flags (see src/lib/flags.ts)
FF_P1A=
FF_P1B=
FF_P1B_GUILDS=
FF_P1B_SOCIAL=
FF_P1C=
FF_P1C_ATLAS=
FF_SOCIAL_COMMENTS=
FF_COMMUNITY_EVENTS=
FF_COMMUNITY_NOTIFICATIONS=
FF_COMMUNITY_SMS=
FF_COMMUNITY_PROGRESS=
FF_COMMUNITY_COLLECTIONS=
CALENDAR_TOKEN_SECRET=
EVENT_SEAT_HOLD_SECONDS=
SMS_SENDER_PER_MINUTE=
SMS_RECIPIENT_PER_MINUTE=
SMS_PAIR_PER_MINUTE=

# Auth (Telegram OIDC: bot id and client secret from BotFather > Web Login)
APP_URL=http://localhost:3000
APP_ENV=local
TELEGRAM_BOT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# E2E-only login: never set in production
TEST_LOGIN_ENABLED=
TEST_LOGIN_SECRET=

# Bridge (site side): AES-256 key (32 bytes, base64) for HMAC secrets, Ed25519 private key (PKCS8 DER, base64)
BRIDGE_KEK=
BRIDGE_ED25519_PRIVATE_KEY=
BRIDGE_SIG_KID=k1

# HMAC key for deletion tombstones (Telegram ID hashes)
TOMBSTONE_HMAC_KEY=
